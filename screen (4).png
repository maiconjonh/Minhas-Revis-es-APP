<!DOCTYPE html>

<html class="light" lang="pt-BR"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>MotoMetrics - Histórico de Manutenção | Triumph Speed 400</title>
<!-- Google Fonts -->
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&amp;family=Manrope:wght@300;400;500;600;700;800&amp;family=Inter:wght@300;400;500;600;700&amp;display=swap" rel="stylesheet"/>
<!-- Material Symbols -->
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<!-- Tailwind CSS -->
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script id="tailwind-config">
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            colors: {
              "primary": "#ff6b00",
              "primary-dark": "#a04100",
              "background": "#f8f9fa",
              "surface": "#ffffff",
              "surface-variant": "#f1f3f5",
              "on-surface": "#1a1a1a",
              "on-surface-variant": "#5f6368",
              "outline": "#dee2e6",
              "accent-orange": "#ff6b00",
            },
            fontFamily: {
              "headline": ["Space Grotesk", "sans-serif"],
              "body": ["Manrope", "sans-serif"],
              "label": ["Inter", "sans-serif"]
            },
            borderRadius: {
                "DEFAULT": "0px",
                "sm": "2px",
                "md": "4px",
                "lg": "8px",
                "xl": "12px"
            },
          },
        },
      }
    </script>
<style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
            display: inline-block;
            vertical-align: middle;
        }
        .torque-gradient {
            background: linear-gradient(135deg, #ff6b00 0%, #a04100 100%);
        }
        .technical-border {
            border-left: 2px solid #ff6b00;
        }
        .grid-bg {
            background-image: radial-gradient(circle at 2px 2px, #e9ecef 1px, transparent 0);
            background-size: 24px 24px;
        }
        body {
            background-color: #f8f9fa;
            color: #1a1a1a;
            min-height: 100vh;
        }
    </style>
</head>
<body class="font-body grid-bg selection:bg-primary/30">
<!-- Header -->
<header class="w-full sticky top-0 z-50 bg-background/80 backdrop-blur-xl border-b border-outline">
<nav class="max-w-5xl mx-auto flex items-center justify-between px-6 py-4">
<div class="flex items-center gap-3">
<div class="p-1.5 bg-primary/10 border border-primary/20 rounded-md">
<span class="material-symbols-outlined text-primary text-2xl" data-icon="settings_input_component">settings_input_component</span>
</div>
<h1 class="font-headline uppercase tracking-widest text-lg font-bold text-on-surface">MOTO<span class="text-on-surface">METRICS</span></h1>
</div>
<div class="flex items-center gap-4">
<button class="p-2 text-on-surface-variant hover:text-primary transition-colors">
<span class="material-symbols-outlined" data-icon="notifications">notifications</span>
</button>
<div class="w-8 h-8 rounded-full border border-primary flex items-center justify-center bg-primary/10">
<span class="material-symbols-outlined text-primary text-sm" data-icon="person">person</span>
</div>
</div>
</nav>
</header>
<main class="max-w-5xl mx-auto px-6 pt-8 pb-32">
<!-- Page Header & Search -->
<section class="mb-10">
<div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
<div class="space-y-1">
<div class="flex items-center gap-2">
<span class="w-2 h-2 bg-primary rounded-full animate-pulse"></span>
<span class="font-label text-[10px] font-bold uppercase tracking-[0.2em] text-primary">Diário de Serviço • Triumph Speed 400</span>
</div>
<h2 class="font-headline text-5xl font-bold tracking-tight text-on-surface">Histórico de Manutenção</h2>
</div>
<div class="relative w-full md:w-72">
<span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-sm" data-icon="search">search</span>
<input class="w-full pl-10 pr-4 py-2.5 bg-surface border border-outline focus:border-primary focus:ring-1 focus:ring-primary/20 transition-all rounded-lg font-body text-sm placeholder:text-on-surface-variant/40" placeholder="Buscar registros..." type="text"/>
</div>
</div>
</section>
<!-- Overview Stats -->
<section class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-10">
<div class="bg-surface border border-outline p-6 rounded-xl relative overflow-hidden group shadow-sm">
<div class="relative z-10">
<p class="font-label text-[10px] font-bold uppercase tracking-widest text-on-surface-variant mb-1">Custo Total de Manutenção</p>
<div class="flex items-baseline gap-1">
<span class="text-primary font-headline text-3xl font-bold">R$</span>
<span class="font-headline text-4xl font-extrabold tracking-tight text-on-surface">312</span>
<span class="font-headline text-lg font-bold text-on-surface-variant">,00</span>
</div>
</div>
<span class="material-symbols-outlined absolute -right-4 -bottom-4 text-7xl text-primary/[0.05] group-hover:text-primary/10 transition-colors duration-500" data-icon="payments">payments</span>
</div>
<div class="bg-surface border border-outline p-6 rounded-xl relative overflow-hidden group shadow-sm">
<div class="relative z-10">
<p class="font-label text-[10px] font-bold uppercase tracking-widest text-on-surface-variant mb-1">Índice de Saúde do Sistema</p>
<div class="flex items-center gap-4">
<span class="font-headline text-4xl font-extrabold tracking-tight text-on-surface">98<span class="text-xl text-primary">%</span></span>
<div class="flex-1 h-1.5 bg-surface-variant rounded-full overflow-hidden">
<div class="h-full bg-primary w-[98%]"></div>
</div>
</div>
</div>
<span class="material-symbols-outlined absolute -right-4 -bottom-4 text-7xl text-primary/[0.05] group-hover:text-primary/10 transition-colors duration-500" data-icon="settings_motorcycle">settings_motorcycle</span>
</div>
<div class="bg-surface border border-outline p-6 rounded-xl flex items-center justify-center shadow-sm">
<button class="w-full h-full py-4 px-6 border border-dashed border-primary/30 hover:border-primary hover:bg-primary/5 rounded-lg flex items-center justify-center gap-3 transition-all group">
<span class="material-symbols-outlined text-primary group-hover:scale-110 transition-transform" data-icon="download">download</span>
<span class="font-label text-xs font-bold uppercase tracking-widest text-primary">Exportar PDF</span>
</button>
</div>
</section>
<!-- History List -->
<div class="space-y-4">
<div class="flex items-center justify-between px-2 mb-2">
<h3 class="font-label text-[10px] font-black uppercase tracking-[0.3em] text-on-surface-variant">Atividade Recente</h3>
<span class="font-label text-[10px] font-bold text-on-surface-variant/50 uppercase">Mais novos primeiro</span>
</div>
<!-- Service Item 1: Chain Adjustment -->
<div class="group bg-surface hover:bg-surface-variant border border-outline hover:border-primary/50 transition-all duration-300 rounded-xl overflow-hidden cursor-pointer shadow-sm">
<div class="flex flex-col md:flex-row items-stretch">
<div class="w-1.5 bg-primary group-hover:w-2 transition-all"></div>
<div class="flex-1 p-5 flex flex-col md:flex-row md:items-center justify-between gap-4">
<div class="flex items-center gap-5">
<div class="w-12 h-12 flex-shrink-0 bg-background border border-outline rounded-lg flex items-center justify-center group-hover:border-primary/30 transition-colors">
<span class="material-symbols-outlined text-primary text-2xl" data-icon="settings_ethernet">settings_ethernet</span>
</div>
<div>
<h4 class="font-headline text-lg font-bold text-on-surface group-hover:text-primary transition-colors">Limpeza da Corrente e Ajuste de Tensão</h4>
<div class="flex items-center gap-4 mt-1">
<span class="flex items-center gap-1.5 font-label text-[10px] font-bold text-on-surface-variant uppercase tracking-wider">
<span class="material-symbols-outlined text-[14px]" data-icon="calendar_today">calendar_today</span> 12 Mar, 2024
                                </span>
<span class="flex items-center gap-1.5 font-label text-[10px] font-bold text-on-surface-variant uppercase tracking-wider">
<span class="material-symbols-outlined text-[14px]" data-icon="speed">speed</span> 2.150 km
                                </span>
</div>
</div>
</div>
<div class="flex items-center justify-between md:justify-end gap-10 border-t md:border-t-0 border-outline pt-4 md:pt-0">
<div class="text-right">
<p class="font-label text-[9px] font-bold uppercase tracking-widest text-on-surface-variant opacity-60">Valor Pago</p>
<p class="font-headline text-xl font-bold text-on-surface">R$ 45,00</p>
</div>
<span class="material-symbols-outlined text-on-surface-variant group-hover:text-primary group-hover:translate-x-1 transition-all" data-icon="arrow_forward_ios">arrow_forward_ios</span>
</div>
</div>
</div>
</div>
<!-- Service Item 2: First Service -->
<div class="group bg-surface hover:bg-surface-variant border border-outline hover:border-primary/50 transition-all duration-300 rounded-xl overflow-hidden cursor-pointer shadow-sm">
<div class="flex flex-col md:flex-row items-stretch">
<div class="w-1.5 bg-primary/40 group-hover:bg-primary transition-all"></div>
<div class="flex-1 p-5 flex flex-col md:flex-row md:items-center justify-between gap-4">
<div class="flex items-center gap-5">
<div class="w-12 h-12 flex-shrink-0 bg-background border border-outline rounded-lg flex items-center justify-center">
<span class="material-symbols-outlined text-on-surface-variant group-hover:text-primary transition-colors text-2xl" data-icon="build">build</span>
</div>
<div>
<h4 class="font-headline text-lg font-bold text-on-surface">Primeira Revisão (1.000km)</h4>
<div class="flex items-center gap-4 mt-1">
<span class="flex items-center gap-1.5 font-label text-[10px] font-bold text-on-surface-variant uppercase tracking-wider">
<span class="material-symbols-outlined text-[14px]" data-icon="calendar_today">calendar_today</span> 15 Jan, 2024
                                </span>
<span class="flex items-center gap-1.5 font-label text-[10px] font-bold text-on-surface-variant uppercase tracking-wider">
<span class="material-symbols-outlined text-[14px]" data-icon="speed">speed</span> 1.020 km
                                </span>
</div>
</div>
</div>
<div class="flex items-center justify-between md:justify-end gap-10 border-t md:border-t-0 border-outline pt-4 md:pt-0">
<div class="text-right">
<p class="font-label text-[9px] font-bold uppercase tracking-widest text-on-surface-variant opacity-60">Valor Pago</p>
<p class="font-headline text-xl font-bold text-on-surface">R$ 225,00</p>
</div>
<span class="material-symbols-outlined text-on-surface-variant group-hover:text-primary transition-all" data-icon="arrow_forward_ios">arrow_forward_ios</span>
</div>
</div>
</div>
</div>
<!-- Service Item 3: Accessories -->
<div class="group bg-surface hover:bg-surface-variant border border-outline hover:border-primary/50 transition-all duration-300 rounded-xl overflow-hidden cursor-pointer shadow-sm">
<div class="flex flex-col md:flex-row items-stretch">
<div class="w-1.5 bg-outline group-hover:bg-primary/50 transition-all"></div>
<div class="flex-1 p-5 flex flex-col md:flex-row md:items-center justify-between gap-4">
<div class="flex items-center gap-5">
<div class="w-12 h-12 flex-shrink-0 bg-background border border-outline rounded-lg flex items-center justify-center">
<span class="material-symbols-outlined text-on-surface-variant group-hover:text-primary transition-colors text-2xl" data-icon="shopping_bag">shopping_bag</span>
</div>
<div>
<h4 class="font-headline text-lg font-bold text-on-surface">Instalação de Protetores de Motor Triumph</h4>
<div class="flex items-center gap-4 mt-1">
<span class="flex items-center gap-1.5 font-label text-[10px] font-bold text-on-surface-variant uppercase tracking-wider">
<span class="material-symbols-outlined text-[14px]" data-icon="calendar_today">calendar_today</span> 05 Dez, 2023
                                </span>
<span class="flex items-center gap-1.5 font-label text-[10px] font-bold text-on-surface-variant uppercase tracking-wider">
<span class="material-symbols-outlined text-[14px]" data-icon="speed">speed</span> 450 km
                                </span>
</div>
</div>
</div>
<div class="flex items-center justify-between md:justify-end gap-10 border-t md:border-t-0 border-outline pt-4 md:pt-0">
<div class="text-right">
<p class="font-label text-[9px] font-bold uppercase tracking-widest text-on-surface-variant opacity-60">Valor Pago</p>
<p class="font-headline text-xl font-bold text-on-surface">R$ 42,00</p>
</div>
<span class="material-symbols-outlined text-on-surface-variant group-hover:text-primary transition-all" data-icon="arrow_forward_ios">arrow_forward_ios</span>
</div>
</div>
</div>
</div>
</div>
</main>
<!-- FAB -->
<button class="fixed bottom-24 right-6 md:right-12 torque-gradient w-16 h-16 rounded-xl shadow-lg shadow-primary/20 text-white flex items-center justify-center group active:scale-95 transition-all z-40">
<span class="material-symbols-outlined text-3xl group-hover:rotate-180 transition-transform duration-500" data-icon="add">add</span>
</button>
<!-- Bottom Nav -->
<footer class="fixed bottom-0 left-0 w-full z-50 flex justify-around items-center px-4 pb-8 pt-4 bg-background/80 backdrop-blur-xl border-t border-outline">
<a class="flex flex-col items-center justify-center text-on-surface-variant hover:text-primary transition-colors" href="#">
<span class="material-symbols-outlined text-2xl" data-icon="speed">speed</span>
<span class="font-label text-[9px] font-bold uppercase tracking-widest mt-1">Status</span>
</a>
<a class="flex flex-col items-center justify-center text-primary" href="#">
<span class="material-symbols-outlined text-2xl" data-icon="history_edu" style="font-variation-settings: 'FILL' 1;">history_edu</span>
<span class="font-label text-[9px] font-bold uppercase tracking-widest mt-1">Histórico</span>
</a>
<a class="flex flex-col items-center justify-center text-on-surface-variant hover:text-primary transition-colors" href="#">
<span class="material-symbols-outlined text-2xl" data-icon="calendar_month">calendar_month</span>
<span class="font-label text-[9px] font-bold uppercase tracking-widest mt-1">Plano</span>
</a>
<a class="flex flex-col items-center justify-center text-on-surface-variant hover:text-primary transition-colors" href="#">
<span class="material-symbols-outlined text-2xl" data-icon="analytics">analytics</span>
<span class="font-label text-[9px] font-bold uppercase tracking-widest mt-1">Dados</span>
</a>
</footer>
</body></html>